# DB: postgres | mysql | sqlite
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cuetiy
DB_SSLMODE=disable
# SQLITE_PATH=./data/cuetiy.db

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
JWT_SECRET=

# 等同于 App「数据与服务器」里填写
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
# MIMO_API_KEY=
# MIMO_API_BASE=https://api.xiaomimimo.com/v1

FRONTEND_URL=http://localhost:5173
RUNTIME_DIR=.
SKILLS_DIR=./skills
STORAGE_DIR=./data/files
ARCHIVE_DIR=./data/archives
# PUBLIC_BASE_URL=

# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

CONTEXT_TOKEN_BUDGET=16384
CONTEXT_COMPACT_THRESHOLD=0.55
RECENT_MIN_MESSAGES=6
SUMMARY_MAX_CHARS=800
MEMORY_MAX_TOKENS=400
SKILL_L2_TTL_TURNS=5
SKILL_ROUTER_MODE=hybrid
ENABLE_AMBIENT_TRIGGERS=false

# 图片生成（Grsai gpt-image-2.5）
# 密钥：https://grsai.ai/zh/dashboard/api-keys
IMAGE_GEN_ENABLED=true
# GRSAI_API_KEY=sk-xxxxxxxx
GRSAI_API_BASE=https://grsaiapi.com
IMAGE_GEN_MODEL=gpt-image-2.5
# gpt-image-2.5 支持比例如 1:1 / 16:9，或像素如 1024x1024
IMAGE_GEN_ASPECT=1:1
IMAGE_GEN_QUALITY=auto
IMAGE_GEN_REPLY_TYPE=json
IMAGE_GEN_STYLE_PROMPT=手机拍摄感照片，自然光线，生活场景
# 外貌与触发词写在技能包（category: image_appearance）的 appearance / image_style / triggers.keywords
# 引擎不写死人设长相；无技能包声明时不会触发出图
# 30 分钟内最多发图次数（防滥用 + 真人感）
IMAGE_GEN_LIMIT_MAX=2
IMAGE_GEN_LIMIT_WINDOW_MIN=30
