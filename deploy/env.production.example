# RainYi 生产环境配置示例
# 复制为 backend/.env 并填入真实值

# ===== MySQL =====
# 若 MySQL 与应用同机：127.0.0.1
# 若使用远程 MySQL：119.13.104.225
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rainyi
DB_PASSWORD=CHANGE_ME
DB_NAME=rain_yi

# ===== 服务 =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# JWT 密钥（生产必须改掉）
JWT_SECRET=CHANGE_ME_RANDOM_32_CHARS

# DeepSeek（聊天必需）
DEEPSEEK_API_KEY=sk-CHANGE_ME
DEEPSEEK_API_URL=https://api.deepseek.com

# CORS（nginx 反代时填前端域名/IP 即可）
FRONTEND_URL=http://119.13.104.225

# 技能目录（相对 backend 工作目录）
SKILLS_DIR=../skills

# ===== Redis（建议开启；不配则回退 MySQL）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== MinIO（可选；不配则头像/技能文件上传不可用）=====
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=CHANGE_ME
# MINIO_BUCKET=rain-yi
# MINIO_USE_SSL=false
