{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RainYi",
  "version": "0.1.0",
  "identifier": "com.rainyi.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RainYi",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/env/.env.unified",
      "resources/skills/*"
    ],
    "externalBin": ["binaries/rainyi-backend"],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {}
}
